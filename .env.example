# ============================================================
# TokenZero — .env.example  (copy to .env and customise)
# ============================================================
# No external API keys needed — this project runs 100% locally
# using Ollama.  Install Ollama from https://ollama.com and pull
# the models below before starting the server.
#
#   ollama pull llama3.2:1b
#   ollama pull llama3.2:3b
#   ollama pull llama3.1:8b
# ============================================================

# Backend: local Ollama
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Router controls
ROUTER_MODE=heuristic
AB_SPLIT_RATIO=0.10
BUDGET_DEFAULT=balanced

# Context manager controls
CONTEXT_WINDOW_SIZE=5
CONTEXT_MAX_TOKENS=4000
SUMMARIZER_MODEL=llama3.2:1b

# Models by tier
# Small  → llama3.2:1b  (fastest,  ~1.3 GB)
# Medium → llama3.2:3b  (balanced, ~2.0 GB)
# Large  → llama3.1:8b  (quality,  ~4.9 GB)
SMALL_MODEL=llama3.2:1b
MEDIUM_MODEL=llama3.2:3b
LARGE_MODEL=llama3.1:8b
MEDIUM_THRESHOLD=0.35
LARGE_THRESHOLD=0.70

# API + logging
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Persistence
SQLITE_PATH=./data/router.db
